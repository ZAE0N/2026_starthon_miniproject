# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 등록돼 있습니다. 절대 커밋하지 마세요.

# 07-appuser.sh 가 출력해 준 줄을 그대로 붙여넣으면 됩니다.
# ?charset=utf8mb4 를 빼면 한글이 물음표로 나옵니다.
DATABASE_URL=mysql+pymysql://inhatc_app:비밀번호@서버IP:3306/mini_project?charset=utf8mb4

# 챗봇용. 없으면 규칙 기반으로 동작합니다 (응답 형식은 동일).
# 이 값은 서버에만 둡니다. 프론트엔드 JS 에 넣으면 브라우저에 그대로 노출됩니다.
OPENAI_API_KEY=

# 함수 하나만 쓰므로 저렴한 소형 모델로 충분합니다.
OPENAI_MODEL=gpt-4o-mini

# 로컬 개발 중 프론트를 다른 포트에서 띄울 때만 필요합니다.
# 배포는 nginx 단일 오리진이라 비워 두면 됩니다.
CORS_ORIGINS=
