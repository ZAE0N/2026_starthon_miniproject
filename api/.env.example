# ──────────────────────────────────────────────────────────────────────
#  api/.env 예시 파일
#
#  이 파일을 복사해서 값을 채우면 됩니다.
#
#      cd api && cp .env.example .env
#
#  ★ .env 는 .gitignore 에 등록돼 있습니다. 절대 커밋하지 마세요.
#    이 파일(.env.example)에도 실제 비밀번호나 API 키를 적으면 안 됩니다.
#
#  ★ 아래 CHANGE_ME 는 반드시 바꿔야 하는 자리입니다.
#    그대로 두면 접속에 실패합니다.
# ──────────────────────────────────────────────────────────────────────


# ── 1. 데이터베이스 (필수) ─────────────────────────────────────────────
#
# 비워 두면 서버가 뜨지 않고 오류를 냅니다.
# 아래 두 가지 중 하나를 고르세요.

# (A) MySQL 로 붙는 경우 — 실제 배포 형태입니다.
#
#     db/deploy/07-appuser.sh 가 실행을 마치면 이 줄을 통째로 출력해 줍니다.
#     그걸 그대로 붙여넣는 것이 가장 안전합니다.
#
#     · API 와 DB 가 같은 서버에 있으면 127.0.0.1 로 두세요.
#       외부 IP 를 거칠 이유가 없고 그편이 더 안전하고 빠릅니다.
#     · ?charset=utf8mb4 를 빼면 한글이 물음표(???)로 저장됩니다.
#
DATABASE_URL=mysql+pymysql://inhatc_app:CHANGE_ME_PASSWORD@127.0.0.1:3306/mini_project?charset=utf8mb4

# (B) SQLite — API 코드를 손볼 때만 쓰세요.
#
#     위 줄을 주석 처리하고 아래 줄을 쓰면 MySQL 없이 서버가 뜹니다.
#     다만 테이블이 자동으로 만들어지지는 않습니다. 한 번 실행해 주세요.
#
#         cd api
#         python -c "from db import Base, engine; import models; \
#                    Base.metadata.create_all(engine)"
#
#     ★ 데이터는 비어 있습니다. db/seed.sql 은 MySQL 전용 구문이라
#       SQLite 에서는 그대로 들어가지 않습니다.
#
#     그래서 **화면을 구경하는 것이 목적이라면 API 를 아예 띄우지 마세요.**
#     API 가 없으면 프론트가 js/data.js 목업으로 71건을 전부 보여 줍니다.
#     어설프게 빈 API 를 띄우면 프론트는 그걸 정상으로 보고
#     목록을 0건으로 그립니다.
#
#         python3 -m http.server 5500     # 이쪽이 훨씬 낫습니다
#
# DATABASE_URL=sqlite:///./local.db


# ── 2. OpenAI (선택) ───────────────────────────────────────────────────
#
# 비워 두어도 챗봇은 동작합니다. 규칙 기반 엔진으로 답하며
# 응답 형식이 같아서 화면 동작에는 차이가 없습니다.
#
# ★ 이 값은 서버에만 둡니다.
#   프론트엔드 JS 에 넣으면 브라우저 개발자 도구에 그대로 노출됩니다.
#   /api/chat 을 서버에 둔 이유이기도 합니다.
#
OPENAI_API_KEY=

# 정의한 함수가 하나뿐이라 토큰을 적게 쓰므로 소형 모델로 충분합니다.
OPENAI_MODEL=gpt-4o-mini


# ── 3. CORS (대개 비워 둡니다) ─────────────────────────────────────────
#
# 배포는 nginx 한 대에서 정적 파일과 API 를 함께 서빙하는 단일 오리진이라
# CORS 설정이 필요 없습니다.
#
# 로컬에서 프론트와 백엔드를 서로 다른 포트로 띄울 때만 채우세요.
# 쉼표로 여러 개를 적을 수 있습니다.
#
#     CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
#
CORS_ORIGINS=
