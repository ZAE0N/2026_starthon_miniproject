# 이 파일을 config.env 로 복사한 뒤 값을 채우세요.
#   cp config.env.example config.env
#
# config.env 는 .gitignore 에 등록돼 있습니다. 절대 커밋하지 마세요.
# 비밀번호는 여기 적지 않습니다. 스크립트가 그때그때 물어봅니다.

# Lightsail 인스턴스 공인 IP  (콘솔 > 인스턴스)
SERVER_IP=13.125.0.0

# SSH 키 파일 경로  (콘솔 > 계정 > SSH 키)
SSH_KEY=~/Downloads/LightsailKey.pem

# SSH 사용자 이름  (Ubuntu 이미지는 보통 ubuntu)
SSH_USER=ubuntu

# 서버에 넣을 덤프 파일 (이 저장소 기준 상대경로)
DUMP_FILE=../dump_from_team.sql

# 덤프 안의 데이터베이스 이름
# 팀원 파일은 CREATE DATABASE mini_project 로 돼 있습니다.
DB_NAME=mini_project

# 앱 전용 계정 이름
APP_USER=inhatc_app

# 백엔드(uvicorn)가 들을 포트. 서버에서 이미 쓰는 포트와 겹치면 바꾸세요.
# nginx 가 이 포트로 /api 를 넘겨주므로, 바꿔도 접속 주소는 그대로입니다.
API_PORT=8010
